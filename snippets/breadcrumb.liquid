{%- comment -%}
  ============================================================
  breadcrumb — trilha de navegação (Início > Loja > página atual)
  ============================================================

  O QUE FAZ:
  Renderiza a trilha "Início > Loja > {{ title }}" no topo de páginas
  internas (ex: produto). O último item (página atual) não é link.

  COMO USAR:
  {% render 'breadcrumb', title: product.title %}

  PARÂMETROS:
  - title: texto do item atual (obrigatório).
  - store_url: sobrescreve o link do item "Loja" (padrão: /collections/all).
  - store_label: sobrescreve o texto do item "Loja" (padrão: "Loja").
{%- endcomment -%}
{%- liquid
  assign store_url = store_url | default: routes.all_products_collection_url
  assign store_label = store_label | default: 'Loja'
-%}
<nav class="breadcrumb page-width" aria-label="breadcrumb">
  <ol class="breadcrumb__list">
    <li class="breadcrumb__item">
      <a href="{{ routes.root_url }}" class="breadcrumb__link">Início</a>
    </li>
    <li class="breadcrumb__item" aria-hidden="true">{% render 'icon', name: 'chevron-right' %}</li>
    <li class="breadcrumb__item">
      <a href="{{ store_url }}" class="breadcrumb__link">{{ store_label }}</a>
    </li>
    <li class="breadcrumb__item" aria-hidden="true">{% render 'icon', name: 'chevron-right' %}</li>
    <li class="breadcrumb__item">
      <span class="breadcrumb__current" aria-current="page">{{ title }}</span>
    </li>
  </ol>
</nav>

<style>
  .breadcrumb { padding-top: 20px; }
  .breadcrumb__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--f1);
  }
  .breadcrumb__item { display: flex; align-items: center; }
  .breadcrumb__item svg { width: 12px; height: 12px; opacity: 0.5; }
  .breadcrumb__link { color: var(--color-text); opacity: 0.6; text-decoration: none; }
  .breadcrumb__link:hover { opacity: 1; text-decoration: underline; }
  .breadcrumb__current { color: var(--color-accent); }
</style>
