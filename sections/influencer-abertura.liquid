{%- comment -%}
  ============================================================
  INFLUENCER ABERTURA — terceira seção da página "Seja Influenciador"
  ============================================================

  O QUE FAZ:
  Bento grid assimétrico com 5 cards de benefícios (ícone, número,
  título, descrição) + CTA final.

  ONDE É USADA:
  templates/page.seja-influencer.json

  OBSERVAÇÕES:
  Segue a mesma paleta/fontes do resto do site (Coiny, Outfit,
  Manrope).
  Versão mobile (≤1000px): o bento de 12 colunas vira um grid fluido
  de colunas automáticas (3 no tablet → 1 no celular), sem os spans
  nem o degrau vertical do desktop, com tipografia e cards reduzidos.
{%- endcomment -%}

<section class="influencer-abertura" data-section-id="{{ section.id }}">
  <div class="influencer-abertura__inner">
    <span class="influencer-abertura__eyebrow">Abertura</span>
    <h2 class="influencer-abertura__title">
      Parceria boa é via<br>de mão dupla.
    </h2>
    <p class="influencer-abertura__subtitle">O que você recebe ao criar com a BRIGZ.</p>

    <div class="influencer-abertura__grid">
      <div class="ia-card ia-card--cyan ia-card--01">
        {% render 'icon', name: 'coin' %}
        <span class="ia-card__badge">01</span>
        <h3 class="ia-card__title">Comissão por venda</h3>
        <p class="ia-card__desc">Ganhe uma % sobre cada venda feita com o seu código exclusivo <strong>BRIGZ</strong>.</p>
      </div>

      <div class="ia-card ia-card--cream ia-card--02">
        {% render 'icon', name: 'ticket' %}
        <span class="ia-card__badge">02</span>
        <h3 class="ia-card__title">Cupom exclusivo</h3>
        <p class="ia-card__desc">Um código só seu para dar desconto e facilitar a conversão.</p>
      </div>

      <div class="ia-card ia-card--orange ia-card--03">
        {% render 'icon', name: 'box' %}
        <span class="ia-card__badge">03</span>
        <h3 class="ia-card__title">Kits para testar</h3>
        <p class="ia-card__desc">Receba produtos <strong>BRIGZ</strong> antes de todo mundo para criar conteúdo.</p>
      </div>

      <div class="ia-card ia-card--cream ia-card--04">
        {% render 'icon', name: 'people' %}
        <span class="ia-card__badge">04</span>
        <h3 class="ia-card__title">Comunidade de creators</h3>
        <p class="ia-card__desc">Faça parte de um grupo com outros parceiros da marca.</p>
      </div>

      <div class="ia-card ia-card--blue ia-card--05">
        {% render 'icon', name: 'chart-up' %}
        <span class="ia-card__badge">05</span>
        <h3 class="ia-card__title">Crescimento contínuo</h3>
        <p class="ia-card__desc">Quanto mais você vende, mais oportunidades e benefícios exclusivos.</p>
      </div>
    </div>

    <a href="#form" class="influencer-abertura__cta">Quero fazer parte</a>
  </div>
</section>

<style>
  .influencer-abertura {
    background-color: #FFF8ED;
    width: 100%;
  }

  .influencer-abertura__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 100px 100px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .influencer-abertura__eyebrow {
    font-family: var(--font-outfit);
    font-weight: 900;
    font-size: 13px;
    letter-spacing: 1.17px;
    text-transform: uppercase;
    color: #F46700;
    text-align: center;
  }

  .influencer-abertura__title {
    font-family: var(--font-coiny);
    font-weight: 400;
    font-size: 94px;
    line-height: 84px;
    letter-spacing: -1.88px;
    color: #4B291D;
    text-align: center;
    margin: 14px 0 0;
  }

  .influencer-abertura__subtitle {
    font-family: var(--font-manrope);
    font-weight: 400;
    font-size: 20px;
    color: #4B291D;
    text-align: center;
    margin: 18px 0 0;
  }

  .influencer-abertura__grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  .ia-card--01 { grid-column: 1 / 6; }
  .ia-card--02 { grid-column: 6 / 9; }
  .ia-card--03 { grid-column: 9 / 13; }
  .ia-card--04 { grid-column: 2 / 7; margin-top: 20px; }
  .ia-card--05 { grid-column: 7 / 12; margin-top: 20px; }

  .ia-card {
    position: relative;
    border: 2px solid #4B291D;
    border-radius: 18px;
    box-shadow: 0 8px 0 #4B291D;
    padding: 28px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-height: 210px;
  }

  .ia-card svg { width: 46px; height: 46px; color: #4B291D; }

  .ia-card--cyan { background-color: #00E6F6; }
  .ia-card--cream { background-color: #FFF8ED; }
  .ia-card--orange { background-color: #F46700; }
  .ia-card--blue { background-color: #4C8CEB; }
  .ia-card--blue svg,
  .ia-card--blue .ia-card__title,
  .ia-card--blue .ia-card__desc { color: #FFFFFF; }

  .ia-card__badge {
    position: absolute;
    top: 24px;
    right: 24px;
    font-family: var(--font-coiny);
    font-size: 15px;
    color: #4B291D;
    opacity: 0.5;
  }

  .ia-card--blue .ia-card__badge { color: #FFFFFF; opacity: 0.6; }

  .ia-card__title {
    font-family: var(--font-coiny);
    font-weight: 400;
    font-size: 35px;
    line-height: 1.05;
    color: #4B291D;
    margin: 0;
  }

  .ia-card__desc {
    font-family: var(--font-manrope);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.4;
    color: #4B291D;
    margin: 0;
  }

  .ia-card__desc strong { font-weight: 800; }

  .influencer-abertura__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 56px;
    padding: 18px 40px;
    background-color: #4C8CEB;
    border: 3px solid #4B291D;
    border-radius: 999px;
    box-shadow: 0 6px 0 #4B291D;
    color: #FFFFFF;
    text-decoration: none;
    font-family: var(--font-outfit);
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .influencer-abertura__cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 9px 0 #4B291D;
  }

  /* ============================================================
     VERSÃO MOBILE
     ============================================================ */
  @media screen and (max-width: 1000px) {
    .influencer-abertura__inner { padding: 60px 30px; } /* mesmo gap lateral do resto do mobile */

    .influencer-abertura__eyebrow {
      font-size: 11px;
      letter-spacing: 1px;
    }

    .influencer-abertura__title {
      /* o <br> do markup trava o título em duas linhas, então a fonte precisa
         acompanhar a largura da tela em vez de um px fixo: cresce até o teto de
         62px no tablet e nunca passa de 32px no limite inferior da faixa,
         garantindo que "Parceria boa é via" caiba sem estourar a lateral */
      font-size: clamp(32px, 7.6vw, 62px);
      line-height: 0.93;
      letter-spacing: -1.2px;
      margin-top: 10px;
    }

    .influencer-abertura__subtitle {
      font-size: 15px;
      margin-top: 12px;
    }

    .influencer-abertura__grid {
      /* o bento de 12 colunas vira fluido: cada card pede no mínimo 260px e o
         próprio grid decide quantas colunas cabem (3 no tablet, 2 no tablet
         pequeno, 1 no celular). O min() impede que o mínimo de 260px fique
         maior que o container e gere scroll horizontal em telas estreitas */
      grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
      gap: 16px;
      margin-top: 36px;
    }

    /* os spans e o degrau vertical só fazem sentido nas 12 colunas do desktop */
    .ia-card--01,
    .ia-card--02,
    .ia-card--03,
    .ia-card--04,
    .ia-card--05 {
      grid-column: auto;
      margin-top: 0;
    }

    .ia-card {
      padding: 22px;
      gap: 8px;
      min-height: 180px;
      border-radius: 16px;
      box-shadow: 0 6px 0 #4B291D; /* menor que o gap de 16px pra sombra não encostar no card de baixo */
    }

    .ia-card svg { width: 38px; height: 38px; }

    .ia-card__badge {
      top: 18px;
      right: 18px;
      font-size: 14px;
    }

    .ia-card__title { font-size: 26px; }

    .ia-card__desc { font-size: 13px; }

    .influencer-abertura__cta {
      margin-top: 40px;
      padding: 15px 32px;
      font-size: 13px;
    }
  }

  /* ============================================================
     CELULAR — node 83:297 do Figma (Sessão 3 - abertura)
     ============================================================
     Medidas do node na tela de 390px. A faixa acima cobre o tablet,
     onde os cards ainda cabem em 2 ou 3 colunas; aqui embaixo é
     sempre uma coluna e valem os valores fixos do design.
     ============================================================ */
  @media screen and (max-width: 600px) {
    .influencer-abertura__inner { padding: 30px 30px 50px; }

    .influencer-abertura__eyebrow {
      font-size: 13px;
      letter-spacing: 1.17px;
    }

    /* O node usa 40px, mas lá o texto quebra sozinho — aqui o <br>
       do markup corta depois de "via", e a 40px a primeira linha já
       estoura antes disso, sobrando um "via" órfão no meio. 8,8vw é
       o tamanho em que "Parceria boa é via" cabe inteira na linha. */
    .influencer-abertura__title {
      font-size: min(8.8vw, 40px);
      line-height: 0.925; /* 37px sobre os 40px do design */
      letter-spacing: normal;
      margin-top: 20px;
    }

    .influencer-abertura__subtitle {
      font-size: 16px;
      margin-top: 16px;
    }

    .influencer-abertura__grid {
      gap: 14px;
      margin-top: 30px;
    }

    .ia-card {
      padding: 24px;
      gap: 9px;
      min-height: 190px;
      border-radius: 12px;
      box-shadow: 0 6px 0 #4B291D;
    }

    .ia-card svg { width: 36px; height: 36px; }

    .ia-card__badge {
      top: 22px;
      right: 21px;
      font-size: 13px;
    }

    .ia-card__title {
      font-size: 29px;
      line-height: 0.98; /* 28,42px sobre os 29px do design */
    }

    .ia-card__desc {
      font-size: 12px;
      line-height: 1.57; /* 18,85px sobre os 12px do design */
    }

    .influencer-abertura__cta {
      margin-top: 30px;
      padding: 17px 18px;
      font-size: 12px;
      box-shadow: 0 6px 0 #4B291D;
    }
  }

  /* ============================================================
     VERSÃO MOBILE PEQUENA (iPhone SE e similares)
     ============================================================
     O título já escala pelo min(10,3vw); aqui só apertamos os
     respiros pra sobrar largura útil dentro dos cards.
     ============================================================ */
  @media screen and (max-width: 400px) {
    .influencer-abertura__inner { padding: 26px 20px 44px; }

    .influencer-abertura__grid { margin-top: 26px; }

    .ia-card {
      padding: 20px;
      min-height: 176px;
    }

    .ia-card svg { width: 32px; height: 32px; }

    .ia-card__badge {
      top: 18px;
      right: 17px;
      font-size: 12px;
    }

    .ia-card__title { font-size: 25px; }

    .influencer-abertura__cta {
      padding: 15px 16px;
      box-shadow: 0 5px 0 #4B291D;
    }

    .influencer-abertura__cta:hover { box-shadow: 0 7px 0 #4B291D; }
  }
</style>

{% schema %}
{
  "name": "Influencer Abertura",
  "class": "section-influencer-abertura",
  "settings": []
}
{% endschema %}
