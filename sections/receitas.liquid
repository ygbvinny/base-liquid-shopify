<style>
  .receitas-section {
    position: relative;
    width: 100%;
    background-color: #FF8A00; /* cor de fallback enquanto o bg carrega */
    overflow: hidden;
  }

  .receitas-section__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .receitas-section__inner {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 50px 100px 60px; /* mesmo gap lateral do resto da home */
    box-sizing: border-box;
  }

  /* Cabeçalho */
  .receitas-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 47px;
    margin-bottom: 40px;
  }

  .receitas-header__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .receitas-header__label {
    font-family: var(--font-outfit);
    font-weight: 900;
    font-size: 12px;
    letter-spacing: 1.56px;
    text-transform: uppercase;
    color: #4B291D;
  }

  .receitas-header__title {
    font-family: var(--font-coiny);
    font-weight: 400;
    font-size: 62px;
    line-height: 1.03;
    letter-spacing: -1.5px;
    color: #4B291D;
    max-width: 900px;
    margin: 0;
  }

  .receitas-header__desc {
    font-family: var(--font-outfit);
    font-weight: 900;
    font-size: 17px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #4B291D;
    max-width: 686px;
    margin: 0;
  }

  .receitas-nav {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .receitas-nav__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    background-color: #FFF6E8;
    border: 2px solid #4B291D;
    border-radius: 50%;
    color: #4B291D;
    cursor: pointer;
    padding: 0;
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .receitas-nav__button:hover {
    background-color: #4B291D;
    color: #FFF6E8;
    transform: translateY(-2px);
  }

  .receitas-nav__button svg { width: 24px; height: 24px; }

  /* Carrossel */
  .receitas-carousel {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* cancela o padding do container pai e reaplica como padding do próprio
       scroll, assim o último card também ganha os 100px de respiro à direita
       (e o primeiro à esquerda) em vez de ficar cortado na borda */
    margin: 0 -100px;
    padding: 0 100px 8px; /* 8px embaixo = mesmo offset do box-shadow do card, senão overflow-x:auto corta a sombra */
    box-sizing: border-box;
  }

  .receitas-carousel::-webkit-scrollbar { display: none; }

  .receitas-card {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    width: 298.5px;
    background-color: #FFF6E8;
    border: 2px solid #4B291D;
    border-radius: 24px;
    box-shadow: 0 8px 0 #4B291D;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .receitas-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16; /* vídeos verticais dos reels */
    overflow: hidden;
    cursor: pointer;
  }

  .receitas-card__media img,
  .receitas-card__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .receitas-card__media video {
    transition: transform 0.25s ease;
  }

  @media (hover: hover) {
    .receitas-card__media:hover video { transform: scale(1.04); }
  }

  .receitas-card__sound {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background-color: #FFF6E8;
    border: 2px solid #4B291D;
    border-radius: 50%;
    color: #4B291D;
    cursor: pointer;
    padding: 0;
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .receitas-card__sound:hover {
    background-color: #4B291D;
    color: #FFF6E8;
    transform: translateY(-2px);
  }

  .receitas-card__sound svg { width: 18px; height: 18px; }

  .receitas-card__sound-icon { display: flex; }

  .receitas-card__sound-icon--on { display: none; }

  .receitas-card__media.is-unmuted .receitas-card__sound {
    background-color: #4B291D;
    color: #FFF6E8;
  }

  .receitas-card__media.is-unmuted .receitas-card__sound-icon--muted { display: none; }

  .receitas-card__media.is-unmuted .receitas-card__sound-icon--on { display: flex; }

  .receitas-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px;
  }

  .receitas-card__footer-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .receitas-card__label {
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #7C665C;
  }

  .receitas-card__title {
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 18px;
    color: #24120E;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .receitas-card__link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: #24120E;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .receitas-card__link:hover { transform: translateX(3px); }

  .receitas-card__footer svg { width: 20px; height: 20px; flex-shrink: 0; color: #24120E; }

  /* ============================================================
     VERSÃO MOBILE
     ============================================================ */
  @media screen and (max-width: 1000px) {
    .receitas-section__bg { display: none; } /* mobile usa só a cor sólida de fundo */

    .receitas-section__inner { padding: 40px 30px 48px; }

    .receitas-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 8px;
    }

    .receitas-header__title {
      font-size: 40px;
      line-height: 42.6px;
      letter-spacing: -1.5px;
      max-width: 400px;
    }

    .receitas-header__desc {
      font-size: 14px;
      letter-spacing: 0;
    }

    .receitas-nav {
      align-self: flex-start;
      margin-top: 8px;
    }

    .receitas-carousel {
      /* sem margin negativo: herda os 30px de padding do .receitas-section__inner
         de graça (nos dois lados), garante o primeiro card afastado da borda
         sem risco de cálculo */
      margin: 0;
      padding: 0 0 8px;
      gap: 20px;
    }

    .receitas-card {
      width: 304px;
      border-width: 1px;
      /* Arredondamento e sombra proporcionais ao desktop (24px/8px @298.5px de
         card = ~8% e ~2.7% da largura do card). Em 304px isso já bate quase
         igual ao desktop, então usamos os mesmos valores. */
      border-radius: 24px;
      box-shadow: 0 8px 0 #4B291D;
    }

    .receitas-card__footer { padding: 12px 15px; }

    .receitas-card__label {
      font-size: 9px;
      letter-spacing: 1.13px;
    }

    .receitas-card__title { font-size: 15px; }
  }

  /* ============================================================
     FAIXA TABLET (601–1000px)
     ============================================================
     O card fixo em 304px foi desenhado pra ~375–400px de tela. Acima
     de 600px ele deixa um "peek" (pedaço do próximo card) aleatório,
     que muda a cada largura. Aqui a largura vira fluida e derivada do
     próprio container do carrossel (100% = largura útil do .receitas-carousel,
     já com os 30px de padding do inner descontados), então o número de
     cards visíveis + o peek fica sempre intencional:

       601–860px  → 2 cards inteiros + ~45% do terceiro (2 gaps de 20px)
       861–1000px → 3 cards inteiros + ~45% do quarto (3 gaps de 20px)

     A troca de 2 pra 3 cards em 860px é proposital: como a mídia é 9:16,
     manter 2 cards acima disso deixaria cada card com mais de 550px de
     altura. O intervalo de largura resultante (≈205–310px) mantém o card
     próximo do tamanho de referência do desktop (298.5px). */
  @media screen and (min-width: 601px) and (max-width: 860px) {
    /* Card ~204-310px nessa faixa (~257px médio): radius/sombra escalados
       na mesma proporção do desktop (~8%/~2.7% da largura do card). */
    .receitas-card {
      width: calc((100% - 40px) / 2.45);
      border-radius: 21px;
      box-shadow: 0 7px 0 #4B291D;
    }
  }

  @media screen and (min-width: 861px) and (max-width: 1000px) {
    /* Card ~215-255px nessa faixa (~235px médio), mesma proporção do desktop. */
    .receitas-card {
      width: calc((100% - 60px) / 3.45);
      border-radius: 19px;
      box-shadow: 0 6px 0 #4B291D;
    }
  }

  /* ============================================================
     VERSÃO MOBILE PEQUENA (iPhone SE e similares)
     ============================================================ */
  @media screen and (max-width: 400px) {
    .receitas-section__inner { padding: 28px 20px 38px; }

    .receitas-header {
      gap: 10px;
      margin-bottom: 6px;
    }

    .receitas-header__label {
      font-size: 9.5px;
      letter-spacing: 1.25px;
    }

    .receitas-header__title {
      font-size: 32px;
      line-height: 34px;
      letter-spacing: -1.2px;
      max-width: 320px;
    }

    .receitas-header__desc { font-size: 11px; }

    .receitas-nav {
      gap: 8px;
      margin-top: 6px;
    }

    .receitas-nav__button {
      width: 37px;
      height: 37px;
    }

    .receitas-nav__button svg { width: 19px; height: 19px; }

    .receitas-carousel { gap: 16px; }

    .receitas-card {
      width: 244px;
      border-radius: 20px; /* mesma proporção do desktop (~8% da largura do card) */
      box-shadow: 0 7px 0 #4B291D;
    }

    .receitas-card__footer {
      gap: 10px;
      padding: 9.5px 12px;
    }

    .receitas-card__footer-text { gap: 5px; }

    .receitas-card__label {
      font-size: 7px;
      letter-spacing: 0.9px;
    }

    .receitas-card__title { font-size: 12px; }

    .receitas-card__footer svg { width: 16px; height: 16px; }

    .receitas-card__sound {
      right: 9px;
      bottom: 9px;
      width: 27px;
      height: 27px;
    }

    .receitas-card__sound svg { width: 15px; height: 15px; }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.receitas-section[data-section-id="{{ section.id }}"]');
    if (!section) return;
    var medias = Array.prototype.slice.call(section.querySelectorAll('[data-receitas-media]'));

    var applySound = function (activeMedia) {
      medias.forEach(function (media) {
        var video = media.querySelector('[data-receitas-video]');
        if (!video) return;

        var isActive = media === activeMedia;
        var soundButton = media.querySelector('[data-receitas-sound]');

        video.muted = !isActive;
        media.classList.toggle('is-unmuted', isActive);

        if (soundButton) {
          soundButton.setAttribute('aria-label', isActive ? 'Desativar som do vídeo' : 'Ativar som do vídeo');
        }

        if (isActive) {
          var played = video.play();
          if (played && played.catch) played.catch(function () {});
        }
      });
    };

    medias.forEach(function (media) {
      media.addEventListener('click', function () {
        var video = media.querySelector('[data-receitas-video]');
        applySound(video && video.muted ? media : null);
      });
    });

    var track = section.querySelector('[data-receitas-track]');
    var prev = section.querySelector('[data-receitas-prev]');
    var next = section.querySelector('[data-receitas-next]');
    if (!track || !prev || !next) return;

    var scrollStep = function () {
      var card = track.querySelector('.receitas-card');
      var gap = parseFloat(getComputedStyle(track).gap) || 0;
      return card ? card.getBoundingClientRect().width + gap : track.clientWidth;
    };

    prev.addEventListener('click', function () {
      track.scrollBy({ left: -scrollStep(), behavior: 'smooth' });
    });
    next.addEventListener('click', function () {
      track.scrollBy({ left: scrollStep(), behavior: 'smooth' });
    });
  })();
</script>

