          <button type="button" class="receitas-card__sound" data-receitas-sound aria-label="Ativar som do vídeo">
            <span class="receitas-card__sound-icon receitas-card__sound-icon--muted">{% render 'icon', name: 'volume-mute' %}</span>
            <span class="receitas-card__sound-icon receitas-card__sound-icon--on">{% render 'icon', name: 'volume-on' %}</span>
