{%- comment -%}
  ============================================================
  MAIN PRODUCT — página nativa de produto (Shopify OS 2.0)
  ============================================================

  O QUE FAZ:
  Renderiza a página completa de um produto: galeria de mídias
  (imagem, vídeo, vídeo externo e modelo 3D), seletor de variantes
  e o formulário nativo de adicionar ao carrinho. O conteúdo é
  montado por blocks configuráveis no editor de temas.

  ONDE É USADA:
  No template de produto (templates/product.json), como section
  principal da página de produto.

  PRINCIPAIS PARTES:
  - product__media-wrapper: percorre product.media e monta cada
    mídia conforme o media_type (image/video/external_video/model).
  - {% form 'product' %}: form nativo com input hidden da variante
    selecionada (current_variant) que dispara o add-to-cart.
  - Loop de section.blocks (case block.type) que renderiza cada
    parte: vendor, title, price, description, variant_picker,
    quantity, buy_buttons, share, custom_liquid e blocos de app.
  - variant_picker: gera swatches por opção e um <script
    data-variant-json> com os dados das variantes (id, options,
    available, mídia e HTML do preço) consumido pelo JS.
  - Renders finais: 'product-media-gallery' e
    'product-variant-selection' cuidam da interatividade (troca
    de mídia ao selecionar variante, etc.).

  OBSERVAÇÕES:
  - A lógica JS de galeria/seleção de variante vive nos snippets
    renderizados no fim do arquivo, não aqui.
  - buy_buttons tem setting show_dynamic_checkout para exibir os
    botões de checkout dinâmico (payment_button).
  - Preço usa o snippet 'price'; ajuste lá para mudar formatação.
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
-%}

{% render 'breadcrumb', title: product.title %}

<section class="product page-width" data-section-id="{{ section.id }}">
 <div class="product__body">
  <div class="product__media-wrapper">
    {%- liquid
      assign gallery_media = product.media | where: 'media_type', 'image'
    -%}

    {%- comment -%}
      ⚠️ TEMPORÁRIO — SÓ PARA PREVIEW DO LAYOUT ⚠️
      Os kits têm 1 imagem só no admin, então o grid de 4 não aparecia.
      preview_repeat repete a mesma lista de mídia N vezes para encher os
      slots e dar o que clicar. PARA DESLIGAR: troque o valor para 1.
      Remover este assign + o loop `for pass` lá embaixo devolve o
      comportamento real (thumbs = mídias de verdade do produto).
    {%- endcomment -%}
    {%- assign preview_repeat = 4 -%}
    {%- if gallery_media.size > 0 -%}
      <div class="product-gallery" data-product-gallery>
        {%- for media in gallery_media -%}
          {%- if forloop.first -%}
            {%- liquid
              assign media_alt = media.alt | default: product.title | escape
              capture full_srcset
                echo media | image_url: width: 400
                echo ' 400w, '
                echo media | image_url: width: 600
                echo ' 600w, '
                echo media | image_url: width: 800
                echo ' 800w, '
                echo media | image_url: width: 1100
                echo ' 1100w, '
                echo media | image_url: width: 1400
                echo ' 1400w'
              endcapture
              capture thumb_srcset
                echo media.preview_image | image_url: width: 160
                echo ' 160w, '
                echo media.preview_image | image_url: width: 250
                echo ' 250w, '
                echo media.preview_image | image_url: width: 360
                echo ' 360w, '
                echo media.preview_image | image_url: width: 500
                echo ' 500w'
              endcapture
            -%}
            <figure class="product-gallery__featured">
              <img
                class="product-gallery__featured-img"
                data-gallery-featured
                src="{{ media | image_url: width: 1400 }}"
                srcset="{{ full_srcset }}"
                sizes="(min-width: 1000px) 50vw, 100vw"
                width="{{ media.preview_image.width }}"
                height="{{ media.preview_image.height }}"
                alt="{{ media_alt }}"
                loading="eager"
                fetchpriority="high"
                data-thumb-src="{{ media.preview_image | image_url: width: 500 }}"
                data-thumb-srcset="{{ thumb_srcset }}"
              >
            </figure>
          {%- endif -%}
        {%- endfor -%}

        {%- if gallery_media.size > 1 or preview_repeat > 1 -%}
          <ul class="product-gallery__thumbs" role="list">
            {%- for pass in (1..preview_repeat) -%}
            {%- for media in gallery_media -%}
              {%- unless pass == 1 and forloop.first -%}
                {%- liquid
                  assign media_alt = media.alt | default: product.title | escape
                  capture full_srcset
                    echo media | image_url: width: 400
                    echo ' 400w, '
                    echo media | image_url: width: 600
                    echo ' 600w, '
                    echo media | image_url: width: 800
                    echo ' 800w, '
                    echo media | image_url: width: 1100
                    echo ' 1100w, '
                    echo media | image_url: width: 1400
                    echo ' 1400w'
                  endcapture
                  capture thumb_srcset
                    echo media.preview_image | image_url: width: 160
                    echo ' 160w, '
                    echo media.preview_image | image_url: width: 250
                    echo ' 250w, '
                    echo media.preview_image | image_url: width: 360
                    echo ' 360w, '
                    echo media.preview_image | image_url: width: 500
                    echo ' 500w'
                  endcapture
                -%}
                <li class="product-gallery__thumb-item">
                  <button
                    type="button"
                    class="product-gallery__thumb"
                    data-gallery-thumb
                    aria-label="Ver esta imagem em destaque"
                  >
                    <img
                      class="product-gallery__thumb-img"
                      src="{{ media.preview_image | image_url: width: 500 }}"
                      srcset="{{ thumb_srcset }}"
                      sizes="(min-width: 1000px) 16vw, 30vw"
                      width="{{ media.preview_image.width }}"
                      height="{{ media.preview_image.height }}"
                      alt="{{ media_alt }}"
                      loading="lazy"
                      data-full-src="{{ media | image_url: width: 1400 }}"
                      data-full-srcset="{{ full_srcset }}"
                    >
                  </button>
                </li>
              {%- endunless -%}
            {%- endfor -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="product__media-item product__media-placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- form 'product',
      product,
      id: product_form_id,
      class: 'product__form',
      novalidate: 'novalidate',
      data-type: 'add-to-cart-form'
    -%}
      <input
        type="hidden"
        name="id"
        value="{{ current_variant.id }}"
        {% if current_variant.available == false %}disabled{% endif %}
        class="product-variant-id"
      >

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div class="product__price" {{ block.shopify_attributes }}>
              {% render 'price', product: product, use_variant: true, show_compare: true %}
              {%- if current_variant.unit_price_measurement -%}
                <div class="product__unit-price">
                  {{ current_variant.unit_price | money }}
                  <span aria-hidden="true">/</span>
                  {%- if current_variant.unit_price_measurement.reference_value != 1 -%}
                    {{ current_variant.unit_price_measurement.reference_value }}
                  {%- endif -%}
                  {{ current_variant.unit_price_measurement.reference_unit }}
                </div>
              {%- endif -%}
              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <div class="product__tax caption">
                  {%- if cart.taxes_included -%}
                    {{ 'products.product.include_taxes' | t }}
                  {%- endif -%}
                  {%- if shop.shipping_policy.body != blank -%}
                    {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          {%- when 'benefits' -%}
            <ul class="product__benefits" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign benefit_icon = 'benefit_icon_' | append: i -%}
                {%- assign benefit_text = 'benefit_text_' | append: i -%}
                {%- assign icon_value = block.settings[benefit_icon] -%}
                {%- assign text_value = block.settings[benefit_text] -%}
                {%- if text_value != blank -%}
                  <li class="product__benefit">
                    {% render 'icon', name: icon_value %}
                    <span>{{ text_value }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="product__variants" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="product__option">
                    <legend class="product__option-name">{{ option.name }}</legend>
                    {%- for value in option.values -%}
                      {%- liquid
                        assign option_disabled = true
                        for variant in product.variants
                          if variant.available and variant.options[forloop.parentloop.index0] == value
                            assign option_disabled = false
                            break
                          endif
                        endfor
                      -%}
                      <label class="product__swatch {% if option.selected_value == value %}is-selected{% endif %} {% if option_disabled %}is-unavailable{% endif %}">
                        <input
                          type="radio"
                          name="{{ option.name }}"
                          value="{{ value | escape }}"
                          class="visually-hidden"
                          {% if option.selected_value == value %}checked{% endif %}
                          data-option-index="{{ forloop.parentloop.index0 }}"
                        >
                        {%- if value.swatch.image -%}
                          <span class="product__swatch-media" style="background-image:url({{ value.swatch.image | image_url: width: 100 }})"></span>
                        {%- elsif value.swatch.color -%}
                          <span class="product__swatch-color" style="background-color:{{ value.swatch.color }}"></span>
                        {%- else -%}
                          <span class="product__swatch-label">{{ value }}</span>
                        {%- endif -%}
                      </label>
                    {%- endfor -%}
                  </fieldset>
                {%- endfor -%}
              </div>

              <script type="application/json" data-variant-json>
                [
                  {%- for variant in product.variants -%}
                    {
                      "id": {{ variant.id | json }},
                      "options": {{ variant.options | json }},
                      "available": {{ variant.available | json }},
                      "featured_media_id": {{ variant.featured_media.id | json }},
                      "price_html": {%- capture variant_price_html -%}{% render 'price', product: variant, use_variant: false, show_compare: true %}{%- endcapture -%}{{ variant_price_html | strip_newlines | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              </script>
            {%- endunless -%}

          {%- when 'quantity' -%}
            <div class="product__quantity" {{ block.shopify_attributes }}>
              <label class="field__label" for="Quantity-{{ section.id }}">
                {{ 'products.product.quantity.label' | t }}
              </label>
              <div class="quantity-selector">
                <button type="button" class="quantity__button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">&minus;</button>
                <input
                  class="quantity__input"
                  type="number"
                  name="quantity"
                  id="Quantity-{{ section.id }}"
                  min="1"
                  value="1"
                  aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}"
                >
                <button type="button" class="quantity__button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">&plus;</button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            {%- comment -%}
              Ordem invertida a pedido do cliente: o checkout expresso
              ("Compre já") vem primeiro e é o CTA principal; o adicionar ao
              carrinho desce pra ação secundária. O CSS de destaque acompanha
              essa ordem em product-media-gallery.liquid.
            {%- endcomment -%}
            <div class="product__buy-buttons" {{ block.shopify_attributes }}>
              {%- comment -%}
                CTA principal, 100% do tema (por isso aceita a cor da marca):
                adiciona ao carrinho via Cart AJAX API e manda pro /checkout.
                É type="button" de propósito — assim o listener de submit do
                assets/carrinho.js não intercepta e abre o drawer.
              {%- endcomment -%}
              <button
                type="button"
                class="button product__buy-now"
                data-buy-now
                {% if current_variant.available == false %}disabled{% endif %}
              >
                <span>Compre já</span>
              </button>

              <button
                type="submit"
                name="add"
                class="button product__add-to-cart"
                {% if current_variant.available == false %}disabled{% endif %}
              >
                {%- if current_variant.available -%}
                  {% render 'icon', name: 'cart' %}
                {%- endif -%}
                <span>
                  {%- if current_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
              </button>

              {%- comment -%}
                Carteiras digitais (Shop Pay / Apple Pay / Google Pay).
                DESLIGADAS a pedido do cliente: elas fecham a compra em um
                toque, sem passar pelo checkout, e o fluxo desejado é o
                checkout normal (endereço + forma de pagamento) via o
                "Compre já" acima. Pra reativar, marque a opção no editor de
                temas — o CSS que dimensiona esses botões continua no
                product-media-gallery.liquid.
              {%- endcomment -%}
              {%- if block.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
            </div>

          {%- when 'share' -%}
            <div class="product__share" {{ block.shopify_attributes }}>
              {% render 'share-button', share_link: product.url, share_title: product.title %}
            </div>

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    {%- endform -%}
  </div>
 </div>

  {% render 'trust-bar', settings_source: section %}
</section>

{% render 'product-media-gallery', section_id: section.id %}
{% render 'product-variant-selection', section_id: section.id, product_form_id: product_form_id %}

<script>
  (function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    var gallery = section.querySelector('[data-product-gallery]');
    if (!gallery) return;

    var featured = gallery.querySelector('[data-gallery-featured]');
    if (!featured) return;

    gallery.addEventListener('click', function (event) {
      var button = event.target.closest('[data-gallery-thumb]');
      if (!button || !gallery.contains(button)) return;

      var thumbImg = button.querySelector('.product-gallery__thumb-img');
      if (!thumbImg) return;

      var featuredState = {
        src: featured.getAttribute('src'),
        srcset: featured.getAttribute('srcset'),
        alt: featured.getAttribute('alt'),
        thumbSrc: featured.dataset.thumbSrc,
        thumbSrcset: featured.dataset.thumbSrcset
      };

      var thumbState = {
        src: thumbImg.getAttribute('src'),
        srcset: thumbImg.getAttribute('srcset'),
        alt: thumbImg.getAttribute('alt'),
        fullSrc: thumbImg.dataset.fullSrc,
        fullSrcset: thumbImg.dataset.fullSrcset
      };

      featured.setAttribute('src', thumbState.fullSrc);
      featured.setAttribute('srcset', thumbState.fullSrcset);
      featured.setAttribute('alt', thumbState.alt);
      featured.dataset.thumbSrc = thumbState.src;
      featured.dataset.thumbSrcset = thumbState.srcset;

      thumbImg.setAttribute('src', featuredState.thumbSrc);
      thumbImg.setAttribute('srcset', featuredState.thumbSrcset);
      thumbImg.setAttribute('alt', featuredState.alt);
      thumbImg.dataset.fullSrc = featuredState.src;
      thumbImg.dataset.fullSrcset = featuredState.srcset;
    });
  })();
</script>

<script>
  /* "Compre já": adiciona a variante selecionada e vai direto pro checkout.
     Usa a mesma Cart AJAX API do assets/carrinho.js, mas sem abrir o drawer. */
  (function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    var button = section.querySelector('[data-buy-now]');
    var form = document.getElementById('{{ product_form_id }}');
    if (!button || !form) return;

    var rootUrl = '{{ routes.root_url }}';
    if (rootUrl.slice(-1) !== '/') rootUrl += '/';

    button.addEventListener('click', function () {
      if (button.hasAttribute('disabled')) return;

      var idInput = form.querySelector('.product-variant-id');
      var qtyInput = form.querySelector('.quantity__input');
      if (!idInput || !idInput.value) return;

      var label = button.querySelector('span');
      var originalLabel = label ? label.textContent : '';
      button.setAttribute('disabled', 'disabled');
      if (label) label.textContent = 'Indo pro checkout…';

      fetch(rootUrl + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          id: idInput.value,
          quantity: parseInt(qtyInput && qtyInput.value ? qtyInput.value : '1', 10)
        })
      })
        .then(function (response) {
          if (!response.ok) throw new Error('add falhou');
          window.location.href = rootUrl + 'checkout';
        })
        .catch(function () {
          /* Devolve o botão ao estado normal — sem isso o cliente fica preso
             num botão morto se a variante esgotar entre o load e o clique. */
          button.removeAttribute('disabled');
          if (label) label.textContent = originalLabel;
        });
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "t:sections.main_product.blocks.vendor.name", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.blocks.price.name", "limit": 1 },
    {
      "type": "benefits",
      "name": "t:sections.main_product.blocks.benefits.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "benefit_icon_1",
          "label": "t:sections.main_product.blocks.benefits.settings.benefit_icon.label",
          "default": "box",
          "options": [
            { "value": "box", "label": "Caixa" },
            { "value": "leaf", "label": "Folha" },
            { "value": "smiley", "label": "Rosto feliz" },
            { "value": "shield", "label": "Escudo" },
            { "value": "credit-card", "label": "Cartão" },
            { "value": "star", "label": "Estrela" },
            { "value": "sparkle", "label": "Brilho" },
            { "value": "check-circle", "label": "Check" },
            { "value": "rocket", "label": "Foguete" }
