{%- comment -%}
  ============================================================
  FOOTER — rodapé do site
  ============================================================

  O QUE FAZ:
  Logo + tagline, links rápidos e ícones de redes sociais numa
  única faixa, com linha divisória e copyright embaixo. Segue o
  mesmo gap lateral de 100px do resto da home.

  OBSERVAÇÕES:
  "Seja Influenciador" aponta para /pages/seja-influenciador (página
  com formulário e design próprio — criar depois). Redes sociais
  usam os links globais do tema (settings.social_instagram_link e
  settings.social_tiktok_link); ícone só aparece se o link estiver
  preenchido. Versão mobile (≤1000px) segue node 49:1925 do Figma:
  tudo centralizado (logo, tagline, links, ícones sociais).
{%- endcomment -%}

<footer class="footer" data-section-id="{{ section.id }}">
  <div class="footer__inner">

    <div class="footer__brand">
      <img
        src="{{ 'logo-brigz.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        class="footer__logo"
        width="140"
        height="56"
        loading="lazy"
      >
      <p class="footer__tagline">
        Brigadeiro de outro mundo.<br>
        <span class="footer__tagline-highlight">Feito para a vida real.</span>
      </p>
    </div>

    <nav class="footer__nav" aria-label="Links do rodapé">
      <ul class="footer__nav-list" role="list">
        <li><a href="/pages/seja-influenciador" class="footer__nav-link"><span class="footer__nav-star" aria-hidden="true">✦</span> Seja Influenciador</a></li>
        <li><a href="{{ routes.all_products_collection_url }}" class="footer__nav-link"><span class="footer__nav-star" aria-hidden="true">✦</span> Comprar</a></li>
        <li><a href="{{ pages['privacidade'].url | default: '/pages/privacidade' }}" class="footer__nav-link"><span class="footer__nav-star" aria-hidden="true">✦</span> Privacidade</a></li>
      </ul>
    </nav>

    <ul class="footer__social" role="list">
      {%- if settings.social_instagram_link != blank -%}
        <li><a href="{{ settings.social_instagram_link }}" class="footer__social-link" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a></li>
      {%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}
        <li><a href="{{ settings.social_tiktok_link }}" class="footer__social-link" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok' %}</a></li>
      {%- endif -%}
    </ul>

    <div class="footer__divider"></div>

    <p class="footer__copyright">BRIGZ {{ 'now' | date: '%Y' }} • Informações comerciais em validação.</p>

  </div>
</footer>

<style>
  .footer {
    background-color: #FFF8ED;
    width: 100%;
  }

  .footer__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px 100px 32px; /* mesmo gap lateral do resto da home */
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1.1fr 1fr 102px;
    column-gap: 50px;
    row-gap: 40px;
    align-items: start;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 29px;
  }

  .footer__logo { display: block; width: 140px; height: auto; }

  .footer__tagline {
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 15.9px;
    line-height: 24px;
    color: #4B291D;
    margin: 0;
  }

  .footer__tagline-highlight { color: #F06904; }

  .footer__nav-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__nav-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 19px;
    color: #4B291D;
    text-decoration: none;
    transition: gap 0.15s ease, color 0.15s ease;
  }

  .footer__nav-link:hover {
    gap: 12px;
    color: #F46700;
  }

  .footer__nav-star { color: #F46700; }

  .footer__social {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    background-color: #FFF6E8;
    border: 2px solid #4B291D;
    border-radius: 23px;
    color: #4B291D;
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .footer__social-link:hover {
    background-color: #4B291D;
    color: #FFF6E8;
    transform: translateY(-2px);
  }

  .footer__social-link svg { width: 24px; height: 24px; }

  .footer__divider {
    grid-column: 1 / -1;
    border-top: 1px solid rgba(75, 41, 29, 0.3);
  }

  .footer__copyright {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-manrope);
    font-weight: 400;
    font-size: 11px;
    color: #4B291D;
  }

  /* ============================================================
     VERSÃO MOBILE
     ============================================================ */
  @media screen and (max-width: 1000px) {
    .footer__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      padding: 40px 30px 33px;
      row-gap: 32px;
    }

    .footer__brand {
      align-items: center;
      text-align: center;
    }

    .footer__nav-list {
      align-items: center;
      gap: 5px;
    }

    .footer__social { justify-content: center; }

    /* traçado sutil só entre os ícones sociais e o copyright, não a tela toda */
    .footer__divider {
      width: 75%;
      max-width: 300px;
      margin: 0 auto;
      border-top: 1.5px solid rgba(75, 41, 29, 0.25);
    }

    .footer__copyright { text-align: center; }
  }

  /* ============================================================
     VERSÃO MOBILE PEQUENA (iPhone SE e similares)
     ============================================================ */
  @media screen and (max-width: 400px) {
    .footer__inner {
      padding: 28px 20px 26px;
      row-gap: 26px;
    }

    .footer__brand { gap: 23px; }

    .footer__logo { width: 112px; }

    .footer__tagline {
      font-size: 12.7px;
      line-height: 19px;
    }

    .footer__nav-list { gap: 4px; }

    .footer__nav-link {
      gap: 6px;
      font-size: 15px;
    }

    .footer__social { gap: 8px; }

    .footer__social-link {
      width: 37px;
      height: 37px;
      border-radius: 18.5px;
    }

    .footer__social-link svg { width: 19px; height: 19px; }

    .footer__divider { max-width: 240px; }

    .footer__copyright { font-size: 9px; }
  }
</style>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": []
}
{% endschema %}
