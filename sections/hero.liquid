{%- comment -%}
  ============================================================
  HERO SECTION — banner principal da home (desktop)
  ============================================================

  O QUE FAZ:
  Banner cheio (assets/hero-banner.webp) com badge, headline,
  subheadline, CTAs e tags de diferenciais por cima, seguindo
  o mesmo gap lateral de 100px usado no navbar.

  OBSERVAÇÕES:
  Versão mobile (≤1000px) segue node 44:1150 do Figma: banner
  próprio (hero-banner-mobile.webp via <picture>), conteúdo
  centralizado, CTAs empilhados, e as tags de diferenciais viram
  2 badges decorativos (imagens) sobrepostos no pote.
{%- endcomment -%}

<section class="hero-section" data-section-id="{{ section.id }}">
  <picture>
    <source media="(max-width: 1000px)" srcset="{{ 'hero-banner-mobile.webp' | asset_url }}">
    <img
      src="{{ 'hero-banner.webp' | asset_url }}"
      alt=""
      class="hero-section__bg"
      width="2880"
      height="1502"
      loading="eager"
      fetchpriority="high"
    >
  </picture>

  <div class="hero-section__inner">
    <div class="hero-section__content">
      <div class="hero-badge">
        {% render 'icon', name: 'rocket' %}
        <span>Brigadeiro de outro mundo</span>
      </div>

      <h1 class="hero-section__title">
        Sua dieta<br>
        não precisa<br>
        ser <span class="hero-section__title-highlight">sem graça.</span>
      </h1>

      <div class="hero-section__subtitle">
        <p>Cremoso de verdade. Intenso do jeito certo.</p>
        <p>O plot twist que faltava na sua rotina.</p>
      </div>

      <div class="hero-actions">
        <a href="{{ section.settings.primary_button_link | default: '#kits' }}" class="hero-cta-primary">
          {% render 'icon', name: 'bag' %}
          <span>Quero provar</span>
        </a>
        <a href="{{ section.settings.secondary_button_link | default: '#beneficios' }}" class="hero-cta-secondary">
          <span>Descobrir o plot twist</span>
          {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>

      <div class="hero-features">
        <div class="hero-feature">
          {% render 'icon', name: 'check-circle' %}
          <span>Zero adição de açúcar</span>
        </div>
        <div class="hero-feature">
          {% render 'icon', name: 'check-circle' %}
          <span>29 kcal</span>
        </div>
        <div class="hero-feature">
          {% render 'icon', name: 'check-circle' %}
          <span>Cacau puro</span>
        </div>
      </div>
    </div>
  </div>

  <!--
    Badges decorativos — aparecem em todas as larguras.

    No desktop precisam grudar no pote, que vive dentro do hero-banner.webp
    renderizado com object-fit: cover. O .hero-badge-anchor reproduz a caixa
    exata da imagem depois do cover (mesma proporção, mesmo centro), então as
    posições em % abaixo acompanham o pote em qualquer viewport.
    No mobile o anchor vira inset:0 e as posições voltam a ser em px/% da seção.
  -->
  <div class="hero-badge-anchor" aria-hidden="true">
    <img
      src="{{ 'hero-badge-sabor-outro-planeta.webp' | asset_url }}"
      alt="Sabor de outro planeta."
      class="hero-decorative-badge hero-decorative-badge--left"
      width="560"
      height="297"
      loading="lazy"
    >
    <img
      src="{{ 'hero-badge-29kcal.webp' | asset_url }}"
      alt="29 kcal por colher"
      class="hero-decorative-badge hero-decorative-badge--right"
      width="720"
      height="405"
      loading="lazy"
    >
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    height: 800px;
    overflow: hidden;
    background-color: #E8720C; /* cor de fallback enquanto o banner carrega */
  }

  .hero-section picture {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-section__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-section__inner {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 100px; /* mesmo gap lateral do navbar */
    box-sizing: border-box;
  }

  .hero-section__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 660px; /* 600px +10%, acompanha o aumento da headline pra manter as 3 linhas */
  }

  /* Badge "Brigadeiro de outro mundo" */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #FFF6E8;
    border: 2px solid #4B291D;
    border-radius: 999px;
    padding: 12px 17px;
    box-shadow: 0 4px 0 #4B291D;
    color: #4B291D;
  }

  .hero-badge svg { width: 20px; height: 20px; flex-shrink: 0; }

  .hero-badge span {
    font-family: var(--font-outfit);
    font-weight: 900;
    font-size: 12px;
    letter-spacing: 0.84px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Headline */
  .hero-section__title {
    font-family: var(--font-coiny);
    font-weight: 400;
    font-size: 77px; /* 70px +10% */
    line-height: 88px; /* 80px +10%, mantém a proporção original */
    letter-spacing: -3.3px; /* -3px +10% */
    width: 100%;
    white-space: nowrap;
    text-transform: uppercase;
    color: #FFF6E8;
    text-shadow: 0 6px 0 #4B291D;
    -webkit-text-stroke: 3px #000000;
    paint-order: fill stroke;
    margin: 0;
  }

  .hero-section__title-highlight { color: #4687EB; }

  /* Subheadline / parágrafo */
  .hero-section__subtitle {
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 20.8px;
    line-height: 30.45px;
    color: #4B291D;
  }

  .hero-section__subtitle p { margin: 0; }

  /* CTAs */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-top: 10px;
  }

  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background-color: #2473CE;
    border: 3px solid #4B291D;
    border-radius: 999px;
    padding: 19px 28px;
    box-shadow: 0 7px 0 #4B291D;
    color: #FFFFFF;
    text-decoration: none;
    font-family: var(--font-outfit);
    font-weight: 900;
    font-size: 13px;
    letter-spacing: 0.455px;
    text-transform: uppercase;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    /* Mesma batida de atenção do "Compre já" da página de produto
       (keyframe em base.css). A sombra deste botão é 7px, não 10px,
       então as vars reapontam o pulo pra altura certa. */
    --cta-sombra-base: 7px;
    --cta-sombra-alta: 11px;
    animation: brigz-cta-atencao 3.2s ease-in-out 1.2s 3;
  }

  .hero-cta-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 0 #4B291D;
  }

  .hero-cta-primary svg { width: 20px; height: 20px; flex-shrink: 0; }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-bottom: 2px solid #4B291D;
    padding: 10px 0 12px;
    color: #4B291D;
    text-decoration: none;
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    transition: gap 0.15s ease, color 0.15s ease;
  }

  .hero-cta-secondary:hover {
    gap: 14px;
    color: #2473CE;
  }

  .hero-cta-secondary svg { width: 20px; height: 20px; flex-shrink: 0; }

  /* Tags de diferenciais */
  .hero-features {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
    row-gap: 8px;
    padding-top: 18px;
  }

  .hero-feature {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .hero-feature svg { width: 20px; height: 20px; flex-shrink: 0; color: #F7D68A; }

  .hero-feature span {
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 12px;
    color: #4B291D;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ------------------------------------------------------------
     Badges decorativos (desktop)

     .hero-badge-anchor = caixa da imagem depois do object-fit: cover.
     Cover em .hero-section (altura fixa 800px) dá:
       largura = max(100% da seção, 800px × 2880/1502) = max(100%, 1534px)
     Com a mesma proporção do arquivo e centralizado, qualquer coordenada em %
     aqui cai no mesmo ponto da arte — o badge não desgruda do pote.

     Referência do pote dentro de hero-banner.webp (2880×1502):
       tampa   x 1390–2590 (48,3%–89,9%)   y 315–535 (21,0%–35,6%)
       rótulo  x 1540–2350 (53,5%–81,6%)   y 1090–1280 (72,6%–85,2%)
     ------------------------------------------------------------ */
  .hero-badge-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max(100%, 1534px);
    aspect-ratio: 2880 / 1502;
    pointer-events: none;
    z-index: 2;
  }

  .hero-decorative-badge {
    display: block;
    position: absolute;
    height: auto;
    pointer-events: none;
  }

  /* "Sabor de outro planeta" — canto inferior esquerdo, encostando no pote */
  .hero-decorative-badge--left {
    width: 14.4%;
    left: 43.06%; /* 44,5% − 10% da largura do badge */
    top: 75%;
  }

  /* "29 kcal por colher" — sobre a borda direita da tampa */
  .hero-decorative-badge--right {
    width: 13.92%; /* 11,6% + 20% */
    left: 80.32%;  /* 83,1% − 20% da largura do badge */
    top: 26.25%;   /* 23,25% (centro preservado no +20%) + 20% da altura do badge */
  }

  /* ============================================================
     VERSÃO MOBILE
     ============================================================ */
  @media screen and (max-width: 1000px) {
    .hero-section {
      width: 100%;
      max-width: 100vw;
      height: auto;
      min-height: 0;
      aspect-ratio: 960 / 1811; /* mesma proporção do hero-banner-mobile.webp, mostra a imagem inteira sem cortar */
    }

    .hero-section__bg { object-position: center; }

    .hero-section__inner {
      max-width: 100%;
      padding: 40px 20px 40px;
      align-items: flex-start;
    }

    .hero-section__content {
      max-width: 100%;
      width: 100%;
      align-items: center;
      text-align: center;
      gap: 10px;
    }

    .hero-badge { padding: 9.5px 13.3px; } /* -5% */
    .hero-badge span { font-size: 10.45px; } /* -5% */

    .hero-section__title {
      font-size: 46.2px; /* 42px +10% */
      line-height: 52.8px; /* 48px +10% */
      letter-spacing: -1.815px; /* -1.65px +10% */
      white-space: normal;
      -webkit-text-stroke: 2px #000000;
      margin-top: 30px; /* soma com o gap de 10px do container = 40px total do badge até aqui */
    }

    .hero-section__subtitle {
      font-size: 15px;
      line-height: 22px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: 10px;
    }

    .hero-cta-primary { width: auto; }

    /* Tags de diferenciais (desktop) somem, viram os 2 badges decorativos */
    .hero-features { display: none; }

    /* O anchor do desktop vira a própria seção: as posições abaixo voltam a
       ser relativas ao hero inteiro, como eram antes. */
    .hero-badge-anchor {
      inset: 0;
      transform: none;
      width: auto;
      height: auto;
      aspect-ratio: auto;
    }

    .hero-decorative-badge {
      display: block;
      position: absolute;
      z-index: 2;
      pointer-events: none;
    }

    /* +15% sobre o tamanho original (92/115px). Os offsets recuam metade do
       crescimento em largura e altura pra manter o CENTRO de cada badge no
       mesmo ponto do pote. */
    .hero-decorative-badge--left {
      width: 105.8px; /* 92px × 1.15 */
      height: auto;
      top: auto;
      left: 43.1px;                /* 50px − 6.9px (metade do +width) */
      bottom: calc(16% - 3.65px);  /* − metade do +height */
      transform: rotate(-4deg);
    }

    .hero-decorative-badge--right {
      width: 132.25px; /* 115px × 1.15 */
      height: auto;
      top: auto;
      left: auto;
      right: 41.38px;              /* 50px − 8.62px (metade do +width) */
      bottom: calc(28% - 4.85px);  /* − metade do +height */
    }
  }

  /* ============================================================
     FAIXA TABLET (441px – 1000px)
     ============================================================
     A arte mobile (hero-banner-mobile.webp) é retrato 960x1811, ou seja,
     1,886x mais alta que larga. Com `aspect-ratio: 960/1811` a section
     full-bleed crescia junto com a largura: 1449px de altura em 768px e
     1885px em 999px — um banner de quase duas telas antes do conteúdo.

     Aqui a altura deixa de ser proporcional e vira "espaço do pote (que
     acompanha a largura da arte) + altura fixa do conteúdo":

       altura = 72,5vw + 510px

     O excesso vira corte no TOPO da arte (`object-position: center bottom`),
     que é justamente o céu vazio onde o texto já fica por cima — o pote,
     o splash e o planeta continuam inteiros. Resultado: 1067px em 768px e
     1234px em 999px, sempre com ~38px de respiro entre o último CTA e a
     tampa do pote.

     O ponto de partida (441px) é exatamente onde essa fórmula cruza a
     altura natural da arte (830px vs 832px), então não há salto ao
     redimensionar vindo do mobile. Abaixo disso o `aspect-ratio` original
     segue valendo, intacto.
     ============================================================ */
  @media screen and (min-width: 441px) and (max-width: 1000px) {
    .hero-section {
      aspect-ratio: auto;
      height: calc(72.5vw + 510px);
    }

    /* Ancora a arte embaixo: o corte come só o céu vazio do topo */
    .hero-section__bg { object-position: center bottom; }

    /* Badges decorativos: em px/% fixos eles descolavam do pote conforme a
       arte crescia. Em vw ficam travados no mesmo ponto da arte em qualquer
       largura da faixa (os valores batem com os 92/115/50px e 16%/28% do
       bloco mobile no cruzamento de 441px, então a transição é contínua). */
    .hero-decorative-badge--left {
      width: 24.04vw;  /* 20.9vw × 1.15 = 106px @441 → 240px @999 */
      left: 9.73vw;    /* 11.3vw − metade do +width */
      bottom: 29.37vw; /* 30.2vw − metade do +height */
    }

    .hero-decorative-badge--right {
      width: 30.02vw;  /* 26.1vw × 1.15 = 132px @441 → 300px @999 */
      right: 9.34vw;   /* 11.3vw − metade do +width */
      bottom: 51.70vw; /* 52.8vw − metade do +height */
    }
  }

  /* ============================================================
     iPAD AIR 5 — RETRATO (820px de largura)
     ============================================================
     Faixa estreita de ±10px em torno de 820px para pegar só o iPad Air 5
     em retrato (o iPad Pro 11" tem 834px e fica de fora). Sem trava de
     `height`: a barra de endereço do Safari some/aparece e muda a altura
     real do viewport, então a regra falharia de forma intermitente.

     Todo o conteúdo cresce 40% sobre os valores herdados do bloco mobile
     (≤1000px). A ARTE DE FUNDO NÃO MUDA — `.hero-section__bg`, o <picture>
     e o `object-position: center bottom` seguem intactos.

     ALTURA: o bloco de texto passa de ~433px para ~586px (+152,6px). Como o
     conteúdo é ancorado no topo e a arte no rodapé, somamos 153px à fórmula
     da faixa tablet para devolver exatamente o mesmo respiro entre o último
     CTA e a tampa do pote (o excesso vira só mais céu vazio no topo, nada
     do pote/splash/planeta é cortado).
     ============================================================ */
  @media screen and (min-width: 810px) and (max-width: 830px) {
    /* 1104px → 1257px @820: +153px = crescimento do bloco de texto */
    .hero-section { height: calc(72.5vw + 510px + 153px); }

    .hero-section__content { gap: 14px; } /* 10px × 1.4 */

    .hero-badge {
      gap: 11.2px;              /* 8px × 1.4 */
      padding: 13.3px 18.62px;  /* 9.5px 13.3px × 1.4 */
    }

    .hero-badge span {
      font-size: 14.63px;       /* 10.45px × 1.4 */
      letter-spacing: 1.176px;  /* 0.84px × 1.4 */
    }

    .hero-badge svg { width: 28px; height: 28px; } /* 20px × 1.4 */

    .hero-section__title {
      font-size: 64.68px;          /* 46.2px × 1.4 */
      line-height: 73.92px;        /* 52.8px × 1.4 */
      letter-spacing: -2.541px;    /* -1.815px × 1.4 */
      -webkit-text-stroke: 2.8px #000000; /* 2px × 1.4, mantém o peso do traçado */
    }

    .hero-section__subtitle {
      font-size: 21px;          /* 15px × 1.4 */
      line-height: 30.8px;      /* 22px × 1.4 */
    }

    .hero-actions { gap: 14px; } /* 10px × 1.4 */

    .hero-cta-primary {
      gap: 12.6px;               /* 9px × 1.4 */
      padding: 26.6px 39.2px;    /* 19px 28px × 1.4 */
      font-size: 18.2px;         /* 13px × 1.4 */
      letter-spacing: 0.637px;   /* 0.455px × 1.4 */
    }

    .hero-cta-primary svg { width: 28px; height: 28px; } /* 20px × 1.4 */

    .hero-cta-secondary {
      gap: 11.2px;              /* 8px × 1.4 */
      padding: 14px 0 16.8px;   /* 10px 0 12px × 1.4 */
      font-size: 19.6px;        /* 14px × 1.4 */
    }

    .hero-cta-secondary svg { width: 28px; height: 28px; } /* 20px × 1.4 */

    /* Badges decorativos: base 40% maior (acima), reduzida em mais 20%
       a pedido do cliente = net 1.4 × 0.8 = 1.12× o tamanho original.
       Offset recuado em metade do encolhimento (largura e altura) pra
       manter o CENTRO de cada badge no mesmo ponto do pote. */
    .hero-decorative-badge--left {
      width: 26.92vw;  /* 23.41vw × 1.15 = 221px @820 */
      left: 8.25vw;    /* 10vw − metade do +width */
      bottom: 28.61vw; /* 29.54vw − metade do +height */
    }

    .hero-decorative-badge--right {
      width: 33.66vw;  /* 29.27vw × 1.15 = 276px @820 */
      right: 7.57vw;   /* 9.76vw − metade do +width */
      bottom: 50.70vw; /* 51.93vw − metade do +height */
    }
  }

  /* ============================================================
     VERSÃO MOBILE PEQUENA (iPhone SE e similares)
     ============================================================ */
  @media screen and (max-width: 400px) {
    .hero-section__inner {
      padding: 31px 16px 32px;
    }

    .hero-section__content { gap: 8px; }

    .hero-badge { padding: 7.5px 10.5px; }
    .hero-badge span { font-size: 8.5px; letter-spacing: 0.67px; }
    .hero-badge svg { width: 16px; height: 16px; }

    .hero-section__title {
      font-size: 37px;
      line-height: 42px;
      letter-spacing: -1.45px;
      margin-top: 21px;
    }

    .hero-section__subtitle {
      font-size: 12px;
      line-height: 17.5px;
    }

    .hero-actions { gap: 8px; }

    .hero-cta-primary {
      gap: 8.5px;
      padding: 18px 40px;
      font-size: 12.5px;
      letter-spacing: 0.44px;
    }

    .hero-cta-primary svg { width: 19px; height: 19px; }

    .hero-cta-secondary {
      gap: 6px;
      padding: 8px 0 9.5px;
      font-size: 11px;
    }

    .hero-cta-secondary svg { width: 16px; height: 16px; }

    .hero-decorative-badge--left {
      width: 85.1px; /* 74px × 1.15 */
      left: 34.45px; /* 40px − metade do +width */
    }

    .hero-decorative-badge--right {
      width: 105.8px; /* 92px × 1.15 */
      right: 33.1px;  /* 40px − metade do +width */
    }
  }
</style>

{% schema %}
{
  "name": "Hero Section",
  "class": "section-hero",
  "settings": [
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Link do botão \"Quero provar\""
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link do botão \"Descobrir o plot twist\""
    }
  ]
}
{% endschema %}
