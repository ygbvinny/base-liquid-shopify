{%- comment -%}
  ============================================================
  NAV / HEADER — cabeçalho do site
  ============================================================

  O QUE FAZ:
  Monta o cabeçalho da loja. 
  Inclui uma faixa de anúncio animada no topo, logo e menu 
  com links fixos ("O plot twist", "Escolha seu kit", 
  "Universo BRIGZ") para replicar fielmente o design.
{%- endcomment -%}

<header class="header" data-section-id="{{ section.id }}">
  
  <!-- FAIXA ANIMADA (MARQUEE) -->
  {%- assign announcement_items = "Zero açúcar,31 kcal por colher,Cacau 100% puro,Brigadeiro de outro mundo" | split: "," -%}
  {%- capture announcement_group -%}
    {%- for repeat in (1..6) -%}
      {%- for item in announcement_items -%}
        <span class="announcement-star" aria-hidden="true">&#10022;</span>
        <span class="announcement-bar__item">{{ item }}</span>
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}
  <div class="announcement-bar">
    <div class="announcement-bar__track">

      <!-- Bloco 1 -->
      <div class="announcement-bar__content">
        {{ announcement_group }}
      </div>

      <!-- Bloco 2 (Cópia exata para o loop infinito sem quebras. O grupo é repetido
           6x em cada bloco pra garantir que o conteúdo sempre preenche telas largas
           (ultrawide/4K) — sem isso, sobra um vão em branco no meio do ciclo do loop.) -->
      <div class="announcement-bar__content" aria-hidden="true">
        {{ announcement_group }}
      </div>

    </div>
  </div>

  <div class="header__inner">
    <button
      type="button"
      class="header__menu-toggle tap-target"
      aria-label="{{ 'sections.header.menu' | t }}"
      aria-expanded="false"
      aria-controls="MobileNav-{{ section.id }}"
    >
      <span class="header__burger"></span>
    </button>

    <a href="{{ routes.root_url }}" class="header__logo-link">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = shop.name | escape -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__logo-image',
            widths: '150, 300, 450, 600',
            width: settings.logo_width,
            height: logo_height,
            alt: logo_alt,
            sizes: '(max-width: 1000px) 40vw, 200px'
        }}
      {%- else -%}
        <img
          src="{{ 'logo-brigz.png' | asset_url }}"
          class="header__logo-image"
          width="140"
          height="56"
          alt="{{ shop.name | escape }}"
          loading="eager"
        >
      {%- endif -%}
    </a>

    <!-- Menu Fixo com os textos da Imagem -->
    <nav class="header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header__menu" role="list">
        <li class="header__menu-item">
          <a href="{{ routes.root_url }}#beneficios" class="header__menu-link">O plot twist</a>
        </li>
        <li class="header__menu-item">
          <a href="{{ routes.root_url }}#kits" class="header__menu-link">Escolha seu kit</a>
        </li>
        <li class="header__menu-item">
          <a href="{{ routes.root_url }}#receitas" class="header__menu-link">Universo BRIGZ</a>
        </li>
      </ul>
    </nav>

    <div class="header__actions">
      <!-- Ocultado via CSS para combinar com o visual da imagem -->
      <details class="header__search">
        <summary class="header__action-button tap-target" aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </summary>
        <div class="header__search-panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.placeholder' | t }}"
              aria-label="{{ 'general.search.search' | t }}"
              class="field__input"
            >
            <button type="submit" class="visually-hidden">{{ 'general.search.submit' | t }}</button>
          </form>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <!-- Ocultado via CSS para combinar com o visual da imagem -->
        <a href="{{ routes.account_url }}" class="header__action-button header__account tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <!-- data-cart-drawer-open: o JS intercepta o clique e abre o drawer.
           O href permanece como fallback quando o JS não carrega. -->
      <a
        href="{{ routes.cart_url }}"
        class="header__action-button header__cart tap-target"
        aria-label="{{ 'templates.cart.cart' | t }}"
        data-cart-drawer-open
        aria-controls="cart-drawer"
        aria-expanded="false"
      >
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
    <div class="header__localization">
      {% render 'localization-form',
        section_id: section.id,
        show_country: section.settings.enable_country_selector,
        show_language: section.settings.enable_language_selector
      %}
    </div>
  {%- endif -%}
</header>

<!-- Menu Mobile Fixo com os textos da Imagem -->
<div class="header__mobile-nav" id="MobileNav-{{ section.id }}" hidden>
  <ul class="header__mobile-menu" role="list">
    <li>
      <a href="{{ routes.root_url }}#beneficios" class="header__mobile-link">O plot twist</a>
    </li>
    <li>
      <a href="{{ routes.root_url }}#kits" class="header__mobile-link">Escolha seu kit</a>
    </li>
    <li>
      <a href="{{ routes.root_url }}#receitas" class="header__mobile-link">Universo BRIGZ</a>
    </li>
  </ul>
</div>

<style>
  /* Variáveis baseadas na imagem de referência */
  :root {
    --header-bg: #FDF5E6;
    --header-color-brown: #4B291D;
    --header-color-orange: #F17A04;
    --header-color-cyan: #00E6F6;
    --topbar-bg: #24120E;
    --topbar-text: #FFF6E8;
  }

  /* --- INÍCIO: FAIXA ANIMADA (MARQUEE) --- */
  .announcement-bar {
    background-color: var(--topbar-bg);
    height: 36px;
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    position: relative;
    display: flex;
    align-items: center;
  }

  .announcement-bar__track {
    display: flex;
    align-items: center;
    gap: 38px;
    width: max-content;
    animation: marquee-scroll 150s linear infinite;
  }

  .announcement-bar__content {
    display: flex;
    align-items: center;
    gap: 38px;
  }

  .announcement-bar__item {
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.96px;
    text-transform: uppercase;
    line-height: 36px;
    color: var(--topbar-text);
  }

  .announcement-star {
    font-size: 12px;
    line-height: 36px;
    color: var(--header-color-cyan);
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } 
  }
  /* --- FIM: FAIXA ANIMADA --- */


  /* Largura 100% da tela e Borda */
  .header {
    background-color: var(--header-bg);
    border-bottom: 2px solid var(--header-color-brown); /* Traçado interno do navbar, 2px no desktop */
    width: 100%;
    max-width: 100%;
    margin: 0;
    box-sizing: border-box;
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center; /* Alinha o grid ao centro */
    width: 100%;
    height: 82px; /* Altura fixa do navbar no desktop */
    padding: 0 100px; /* 100px de gap na esquerda e na direita */
    box-sizing: border-box;
  }

  .header__logo-link {
    justify-self: start;
    text-decoration: none;
    display: flex; /* Força que a logo não tenha espaços fantasmas de texto */
    align-items: center;
  }
  
  .header__logo-image { display: block; height: auto; }
  .header__logo-text { 
    font-family: var(--font-outfit);
    font-size: var(--f4); 
    color: var(--header-color-brown); 
    font-weight: 800; 
    line-height: 1;
  }
  
  .header__nav { 
    justify-self: center; 
    display: flex;
    align-items: center;
  }
  
  .header__menu {
    display: flex;
    align-items: center;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  
  .header__menu-item { 
    position: relative; 
    display: flex;
    align-items: center;
  }
  
  .header__menu-link,
  .header__submenu-link {
    font-family: var(--font-outfit);
    font-size: 16px;
    font-weight: 800;
    color: var(--header-color-brown);
    text-decoration: none;
    display: flex; /* Flex ajuda alinhar ao centro exatamente */
    align-items: center;
    line-height: 1; /* Tira o espaço extra da fonte em cima/embaixo */
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .header__menu-link:hover,
  .header__submenu-link:hover {
    color: var(--header-color-orange);
    transform: translateY(-2px);
  }
  
  .header__actions { 
    justify-self: end;
    display: flex; 
    align-items: center; 
    gap: 16px; 
  }
  
  .header__search, 
  .header__account {
    display: none;
  }
  
  .header__cart {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: transparent;
    border: 2.5px solid var(--header-color-brown);
    border-radius: 50%;
    color: var(--header-color-brown);
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .header__cart:hover {
    background-color: var(--header-color-brown);
    color: #FFF6E8;
    transform: translateY(-2px);
  }
  
  .header__cart svg { 
    width: 22px; 
    height: 22px; 
    fill: currentColor;
    display: block;
  }
  
  .header__cart-count {
    position: absolute;
    top: -6px;
    right: -6px;
    z-index: 2;
    min-width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-outfit);
    font-size: 13px;
    font-weight: 800;
    color: #FFFFFF;
    background-color: var(--header-color-orange);
    border: 2.5px solid var(--header-color-brown);
    border-radius: 50%;
    line-height: 1;
    box-sizing: border-box;
  }

  /* --- INÍCIO: FEEDBACK "ITEM ADICIONADO" NO CARRINHO ---
     O JS do carrinho adiciona a classe .is-bumping no badge
     ([data-cart-count]) por ~600ms sempre que um item entra no carrinho.
     Pode ser aplicada também no .header__cart (botão) para o mesmo efeito. */
  .header__cart-count.is-bumping,
  .header__cart.is-bumping .header__cart-count {
    animation: header-cart-bump 0.45s ease;
  }

  /* Onda que sai do badge ao adicionar item */
  .header__cart-count::after {
    content: '';
    position: absolute;
    inset: -5px;
    border: 2.5px solid var(--header-color-orange);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .header__cart-count.is-bumping::after,
  .header__cart.is-bumping .header__cart-count::after {
    animation: header-cart-ring 0.6s ease-out;
  }

  /* Balanço leve do botão do carrinho junto com o badge */
  .header__cart.is-bumping {
    animation: header-cart-shake 0.45s ease;
  }

  @keyframes header-cart-bump {
    0% { transform: scale(1) rotate(0deg); }
    25% { transform: scale(1.4) rotate(-8deg); }
    50% { transform: scale(0.9) rotate(6deg); }
    75% { transform: scale(1.15) rotate(-3deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  @keyframes header-cart-ring {
    0% { opacity: 0.9; transform: scale(1); }
    100% { opacity: 0; transform: scale(2.1); }
  }

  @keyframes header-cart-shake {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    30% { transform: translateY(-3px) rotate(-6deg); }
    60% { transform: translateY(-1px) rotate(4deg); }
  }
  /* --- FIM: FEEDBACK "ITEM ADICIONADO" NO CARRINHO --- */

  .header__menu-toggle {
    display: none;
    background: none; 
    border: none; 
    cursor: pointer;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
  }

  .header__burger,
  .header__burger::before,
  .header__burger::after {
    display: block;
    width: 22px;
    height: 2.5px;
    background-color: var(--header-color-brown);
    transition: transform 0.2s ease;
  }
  
  .header__burger { position: relative; }
  .header__burger::before { content: ''; position: absolute; top: -7px; }
  .header__burger::after { content: ''; position: absolute; top: 7px; }
  
  .header__mobile-nav {
    padding: 16px 20px;
    background-color: var(--header-bg);
    border-top: 1px solid var(--header-color-brown);
    border-bottom: 1px solid var(--header-color-brown);
  }
  
  .header__mobile-menu { list-style: none; margin: 0; padding: 0; }
  
  .header__mobile-link { 
    display: block; 
    padding: 12px 0; 
    font-family: var(--font-outfit);
    font-size: 18px; 
    font-weight: 800;
    color: var(--header-color-brown); 
    text-decoration: none; 
  }
  
  .header__localization { padding: 8px 0; }

  /* ============================================================
     VERSÃO TABLET (740px – 1000px)
     ------------------------------------------------------------
     O menu tem só 3 links curtos ("O plot twist", "Escolha seu kit",
     "Universo BRIGZ") e ocupa ~400px no desktop. Somando logo + carrinho,
     o header completo cabe com folga a partir de ~740px reduzindo
     padding lateral, gap do menu e logo de forma fluida (clamp).
     Por isso o hambúrguer só entra abaixo de 740px — assim tablets
     em retrato (iPad 768/810/820/834) continuam com o menu completo.
     ============================================================ */
  @media screen and (min-width: 740px) and (max-width: 1000px) {
    .header {
      border-bottom-width: 1px;
    }

    /* Mantém o grid do desktop (1fr auto 1fr), só reduz as medidas */
    .header__inner {
      height: 72px;
      padding: 0 clamp(20px, 4vw, 40px);
    }

    .header__logo-image { width: clamp(96px, 12vw, 120px); }

    .header__menu { gap: clamp(18px, 3vw, 32px); }

    .header__menu-link { font-size: 15px; }

    .header__actions { gap: 12px; }

    /* 44px = alvo de toque mínimo (WCAG 2.5.5) */
    .header__cart {
      width: 44px;
      height: 44px;
    }

    .header__cart svg {
      width: 20px;
      height: 20px;
    }

    /* Nesta faixa o menu completo está visível: sem hambúrguer */
    .header__menu-toggle { display: none; }

    .announcement-bar__track,
    .announcement-bar__content { gap: 20px; }
  }

  /* ============================================================
     VERSÃO MOBILE (até 739px)
     ============================================================ */
  @media screen and (max-width: 739px) {
    .header {
      border-bottom-width: 1px; /* 1px no mobile */
    }

    .header__inner {
      display: flex;
      align-items: center; /* Mantém alinhado verticalmente no centro */
      height: auto;
      padding: 16px; /* 16px lateral no mobile */
      gap: 16px;
    }
    
    .header__nav { display: none; }

    .header__logo-image { width: 90px; } /* 140px -20% -20% */

    /* Logo na esquerda empurrando os outros para direita */
    .header__logo-link { 
      margin: 0;
      margin-right: auto;
      order: 1; 
    }
    
    /* Ações (Carrinho) como segundo elemento */
    .header__actions {
      order: 2;
    }

    /* Menu sanduíche ativado e posicionado como último elemento */
    .header__menu-toggle { 
      display: flex; /* Mudança para flex pra garantir alinhamento do burger */
      order: 3;
    }
    
    /* Ajuste para mobile da faixa animada */
    .announcement-bar__track,
    .announcement-bar__content { gap: 20px; }
  }

  /* ============================================================
     VERSÃO MOBILE PEQUENA (iPhone SE e similares)
     ============================================================ */
  @media screen and (max-width: 400px) {
    .announcement-bar { height: 29px; }

    .announcement-bar__track,
    .announcement-bar__content { gap: 16px; }

    .announcement-bar__item {
      font-size: 9.5px;
      letter-spacing: 0.77px;
      line-height: 29px;
    }

    .announcement-star {
      font-size: 9.5px;
      line-height: 29px;
    }

    .header__inner {
      padding: 12px;
      gap: 12px;
    }

    .header__logo-image { width: 72px; }

    .header__actions { gap: 12px; }

    .header__cart {
      width: 38px;
      height: 38px;
    }

    .header__cart svg {
      width: 18px;
      height: 18px;
    }

    .header__cart-count {
      top: -5px;
      right: -5px;
      min-width: 19px;
      height: 19px;
      font-size: 10.5px;
    }

    .header__menu-toggle {
      width: 38px;
      height: 38px;
    }

    .header__burger,
    .header__burger::before,
    .header__burger::after { width: 18px; }

    .header__burger::before { top: -6px; }
    .header__burger::after { top: 6px; }

    .header__mobile-nav { padding: 12px 16px; }

    .header__mobile-link {
      padding: 9.5px 0;
      font-size: 14.5px;
    }
  }

  /* Painel do hambúrguer só existe abaixo de 740px. Isso também evita
     que ele fique "preso" aberto se o usuário abrir no mobile e girar
     o tablet / redimensionar a janela para a faixa com menu completo. */
  @media screen and (min-width: 740px) {
    .header__mobile-nav { display: none !important; }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.header[data-section-id="{{ section.id }}"]');
    if (!section) return;
    var toggle = section.querySelector('.header__menu-toggle');
    var nav = document.getElementById('MobileNav-{{ section.id }}');
    if (toggle && nav) {
      toggle.addEventListener('click', function () {
        var open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav.hidden = open;
      });
    }
  })();
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.header.settings.header__localization.content"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.header.settings.enable_country_selector.label"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.header.settings.enable_language_selector.label"
    }
  ]
}
{% endschema %}